f:[["$","p",null,{"children":["Marcussen Motorsports",", based in ","Iowa, United States",", is responsible for the personal information described in this policy. It covers the Metrik website, customer inquiries, and the planned online store."]}],["$","p",null,{"children":"The gauge and phone displays on this website are demonstrations. This website does not connect to your vehicle or collect readings from your gauge. A separate notice will describe the app’s data practices when the app is available."}]]
10:["$","section","information",{"id":"information","aria-labelledby":"information-title","children":[["$","div",null,{"className":"policy-section-heading","children":[["$","span",null,{"aria-hidden":"true","children":"02"}],["$","h2",null,{"id":"information-title","children":"Information we receive"}]]}],[["$","p",null,{"children":"When you contact us, we receive the details you choose to send, such as your name, email address, order reference, and the contents of your message."}],["$","p",null,{"children":"When ordering becomes available, we will receive the information needed to handle your purchase: contact details, billing and delivery details, products ordered, payment status, and records of refunds or support requests."}],["$","p",null,{"children":["This website is hosted on GitHub Pages. Loading it sends technical information, such as your IP address and requested files, to GitHub. GitHub logs visitors’ IP addresses for security purposes; see ",["$","a",null,{"href":"https://docs.github.com/en/site-policy/privacy-policies/github-general-privacy-statement","target":"_blank","rel":"noopener noreferrer","children":"GitHub’s privacy statement"}],". The Metrik website does not use a customer account system or third-party visitor analytics."]}]]]}]
11:["$","section","uses",{"id":"uses","aria-labelledby":"uses-title","children":[["$","div",null,{"className":"policy-section-heading","children":[["$","span",null,{"aria-hidden":"true","children":"03"}],["$","h2",null,{"id":"uses-title","children":"How information is used"}]]}],[["$","ul",null,{"children":[["$","li",null,{"children":"Answer questions and provide product or order support."}],["$","li",null,{"children":"Process purchases, arrange delivery, and handle returns and refunds when the store opens."}],["$","li",null,{"children":"Keep necessary business records and investigate payment disputes or misuse."}],["$","li",null,{"children":"Maintain the website and diagnose technical problems."}]]}],["$","p",null,{"children":"We do not sell personal information or use this storefront to share it for targeted advertising. This preview has no marketing signup or advertising pixels."}]]]}]
12:["$","section","stripe",{"id":"stripe","aria-labelledby":"stripe-title","children":[["$","div",null,{"className":"policy-section-heading","children":[["$","span",null,{"aria-hidden":"true","children":"04"}],["$","h2",null,{"id":"stripe-title","children":"Payments through Stripe"}]]}],[["$","p",null,{"children":"We plan to use Stripe-hosted checkout. When enabled, payment details will be entered on Stripe’s payment page; this website will not ask you to send a card number or security code to us."}],["$","p",null,{"children":["Stripe handles payment information and processes transaction and device data for its payment and fraud-prevention services. We receive order information and payment status needed to fulfill your purchase, rather than your card security code. See ",["$","a",null,{"href":"https://stripe.com/privacy","target":"_blank","rel":"noopener noreferrer","children":"Stripe’s privacy policy"}]," for its own practices."]}]]]}]
13:["$","section","fundraising",{"id":"fundraising","aria-labelledby":"fundraising-title","children":[["$","div",null,{"className":"policy-section-heading","children":[["$","span",null,{"aria-hidden":"true","children":"05"}],["$","h2",null,{"id":"fundraising-title","children":"A future GoFundMe campaign"}]]}],[["$","p",null,{"children":"We plan to link to a GoFundMe campaign supporting the Metrik launch. Following that link takes you to a separate platform. Contributions are handled there, not by a payment form on this website."}],["$","p",null,{"children":"GoFundMe’s privacy notice and campaign terms explain how contributor information is handled and what may be shared with the organizer. Review them on the campaign page before contributing. A contribution is separate from a direct store purchase."}]]]}]
14:["$","section","sharing",{"id":"sharing","aria-labelledby":"sharing-title","children":[["$","div",null,{"className":"policy-section-heading","children":[["$","span",null,{"aria-hidden":"true","children":"06"}],["$","h2",null,{"id":"sharing-title","children":"Who information is shared with"}]]}],[["$","p",null,{"children":"For store operations, information may be shared with service providers that help process payments, deliver packages, host the website, provide email support, or maintain required financial records. They receive information relevant to their role."}],["$","p",null,{"children":"Information may also be disclosed when legally required or needed to address fraud, a payment dispute, or the protection of legal rights. Some providers, including Stripe, may process information in other countries under their applicable privacy arrangements."}]]]}]
15:["$","section","eu-privacy",{"id":"eu-privacy","aria-labelledby":"eu-privacy-title","children":[["$","div",null,{"className":"policy-section-heading","children":[["$","span",null,{"aria-hidden":"true","children":"07"}],["$","h2",null,{"id":"eu-privacy-title","children":"EU privacy rights"}]]}],[["$","p",null,{"children":"Where the GDPR applies, we process order information to perform a contract, necessary accounting records to meet legal obligations, and support or security information for legitimate interests balanced against your rights. Where consent is required, we ask for it and you may withdraw it."}],["$","p",null,{"children":["You may have rights to access, correct, delete, restrict or object to processing, receive portable data, and complain to your data-protection authority. Contact us to exercise a right. See the ",["$","a",null,{"href":"https://commission.europa.eu/law/law-topic/data-protection/information-individuals_en","target":"_blank","rel":"noopener noreferrer","children":"European Commission’s guide to your rights"}],"."]}],["$","p",null,{"children":"We are based in the United States. Before EU sales begin, we will identify relevant international-transfer arrangements and any required EU privacy representative in this notice. Those operational details remain part of launch preparation."}]]]}]
16:["$","section","cookies",{"id":"cookies","aria-labelledby":"cookies-title","children":[["$","div",null,{"className":"policy-section-heading","children":[["$","span",null,{"aria-hidden":"true","children":"08"}],["$","h2",null,{"id":"cookies-title","children":"Cookies and browser storage"}]]}],[["$","p",null,{"children":"The current Metrik storefront does not set advertising or analytics cookies. Your selected example profile and motion setting remain in the current page’s memory, and your browser may cache images and fonts to make repeat visits faster."}],["$","p",null,{"children":["If you follow a checkout link, Stripe may use cookies or similar technologies on its own checkout. Those technologies are described in ",["$","a",null,{"href":"https://stripe.com/legal/cookies-policy","target":"_blank","rel":"noopener noreferrer","children":"Stripe’s cookie policy"}],"."]}]]]}]
17:["$","section","retention",{"id":"retention","aria-labelledby":"retention-title","children":[["$","div",null,{"className":"policy-section-heading","children":[["$","span",null,{"aria-hidden":"true","children":"09"}],["$","h2",null,{"id":"retention-title","children":"Retention and security"}]]}],[["$","p",null,{"children":"We keep personal information for as long as needed for its purpose, including order support, returns, accounting requirements, and resolving disputes. The appropriate period depends on the record and applicable legal obligations."}],["$","p",null,{"children":"Access should be limited to people and providers who need it for these purposes. Please do not include card details, passwords, or other unnecessary sensitive information in support messages."}]]]}]
