f:["$","p",null,{"children":"This policy covers direct purchases from Marcussen Motorsports. If you bought through another retailer, contact that retailer about its returns process. A future GoFundMe contribution is separate from a store purchase and is subject to the campaign and platform’s refund rules."}]
10:["$","section","request",{"id":"request","aria-labelledby":"request-title","children":[["$","div",null,{"className":"policy-section-heading","children":[["$","span",null,{"aria-hidden":"true","children":"02"}],["$","h2",null,{"id":"request-title","children":"How to request a return"}]]}],[["$","ol",null,{"children":[["$","li",null,{"children":"Contact us with your order number and purchase email. A reason is helpful but is not required for a change-of-mind return. For a damaged or incorrect item, describe the problem and include photos if available."}],["$","li",null,{"children":"We will provide return instructions and the correct address. Please use those instructions rather than sending a parcel to an unconfirmed address."}],["$","li",null,{"children":"Pack the gauge securely with the items included in the return. Keep your shipping receipt and tracking details until the return is resolved."}]]}],["$","p",null,{"children":["$","a",null,{"href":"mailto:BraydonMarcussen@marcussenmotorsports.com","children":"BraydonMarcussen@marcussenmotorsports.com"}]}],["$","p",null,{"children":"Do not include passwords, payment-card details, or unnecessary personal information in a return request."}]]]}]
11:["$","section","shipping-costs",{"id":"shipping-costs","aria-labelledby":"shipping-costs-title","children":[["$","div",null,{"className":"policy-section-heading","children":[["$","span",null,{"aria-hidden":"true","children":"03"}],["$","h2",null,{"id":"shipping-costs-title","children":"Return shipping and charges"}]]}],[["$","p",null,{"children":"For an ordinary change-of-mind return, you pay the return shipping. We refund the product price paid and the original standard delivery charge. Any extra charge for an upgraded delivery service is not refunded. We do not charge a restocking fee."}],["$","p",null,{"children":"For a faulty, damaged-on-arrival, or incorrect item, we cover the necessary return shipping. Contact us first so we can provide a return label or agree how the return will be sent."}]]]}]
12:["$","section","eu-withdrawal",{"id":"eu-withdrawal","aria-labelledby":"eu-withdrawal-title","children":[["$","div",null,{"className":"policy-section-heading","children":[["$","span",null,{"aria-hidden":"true","children":"04"}],["$","h2",null,{"id":"eu-withdrawal-title","children":"EU right of withdrawal"}]]}],[["$","p",null,{"children":"If EU distance-selling rules apply, you may notify us within 14 days of delivery that you wish to withdraw, without giving a reason, then send the goods back within 14 days of that notice. An unequivocal email is sufficient; prior approval is not required."}],["$","p",null,{"children":"We refund the payment, including standard outbound delivery, within 14 days of your notice. We may withhold reimbursement until we receive the goods or evidence of return, whichever comes first. Ordinary return postage is your responsibility. Extra express-delivery costs need not be refunded."}],["$","p",null,{"children":["Our 30-day policy adds time; it does not replace statutory rights. The undamaged-item condition does not override the legal right to inspect goods or the applicable rules on diminished value. See ",["$","a",null,{"href":"https://europa.eu/youreurope/business/selling-in-eu/selling-goods-services/ecommerce-distance-selling/index_en.htm","target":"_blank","rel":"noopener noreferrer","children":"EU guidance on withdrawal"}],"."]}],["$","details",null,{"className":"withdrawal-example","children":[["$","summary",null,{"children":"Optional withdrawal email"}],["$","p",null,{"children":["To: ","Marcussen Motorsports",", ",["$","a",null,{"href":"mailto:BraydonMarcussen@marcussenmotorsports.com","children":"BraydonMarcussen@marcussenmotorsports.com"}]]}],["$","p",null,{"children":"I am withdrawing from my purchase of [product and order number], ordered on [date] and received on [date]."}],["$","p",null,{"children":["Name: [your name]",["$","br",null,{}],"Address: [your address]",["$","br",null,{}],"Date: [today’s date]"]}],["$","p",null,{"children":"You may use your own wording instead. Do not include card details."}]]}]]]}]
13:["$","section","faults",{"id":"faults","aria-labelledby":"faults-title","children":[["$","div",null,{"className":"policy-section-heading","children":[["$","span",null,{"aria-hidden":"true","children":"05"}],["$","h2",null,{"id":"faults-title","children":"Faulty or incorrect items"}]]}],[["$","p",null,{"children":"Please tell us if your gauge arrives damaged, has a fault, or does not match your order. Include enough detail for us to understand the issue and identify your purchase."}],["$","p",null,{"children":"Depending on the issue and applicable law, the remedy may be a repair, replacement, or refund. The change-of-mind window and packaging conditions do not limit rights you have for a faulty, incorrect, or misdescribed product."}]]]}]
14:["$","section","cancellation",{"id":"cancellation","aria-labelledby":"cancellation-title","children":[["$","div",null,{"className":"policy-section-heading","children":[["$","span",null,{"aria-hidden":"true","children":"06"}],["$","h2",null,{"id":"cancellation-title","children":"Canceling an order"}]]}],[["$","p",null,{"children":"Contact us as soon as possible if you want to cancel before dispatch. If the order has already shipped, we will explain the applicable return process."}],["$","p",null,{"children":"Any preorder will have its estimated dispatch timing stated before payment. If we cannot ship within the promised time, we will explain the delay and the cancellation/refund options required by law. If we cancel an order we cannot fulfill, any payment due back to you will be refunded."}]]]}]
15:["$","section","refunds",{"id":"refunds","aria-labelledby":"refunds-title","children":[["$","div",null,{"className":"policy-section-heading","children":[["$","span",null,{"aria-hidden":"true","children":"07"}],["$","h2",null,{"id":"refunds-title","children":"Receiving a refund"}]]}],[["$","p",null,{"children":"After receiving a return, we will inspect it and tell you the outcome. If there is a disagreement about its condition or eligibility, we will explain the reason and how to contact us."}],["$","p",null,{"children":["We issue approved refunds within 5 business days of receiving the return, subject to any shorter legal deadline."," Approved refunds will normally be sent to the original payment method through Stripe. Your bank or payment provider may take additional time to display the funds."]}],["$","p",null,{"children":"We will not ask you to pay an extra fee to release a refund. Applicable legal refund deadlines take priority over our standard processing times."}]]]}]
