f:["$","section","product",{"id":"product","aria-labelledby":"product-title","children":[["$","div",null,{"className":"policy-section-heading","children":[["$","span",null,{"aria-hidden":"true","children":"02"}],["$","h2",null,{"id":"product-title","children":"Product information"}]]}],[["$","p",null,{"children":"Review the product description and compatibility information before buying. The current gauge specifications include a 52 mm body diameter, 56 mm bezel outer diameter, 7 mm bezel depth, and 17 mm depth behind the bezel. The display is rated at 450 nits and has an anti-glare coating."}],["$","p",null,{"children":"Animations, app recordings and example screen profiles illustrate the product. A phone shown in a demonstration is not a promise that a phone is included. Included accessories, supported features, and app availability will be stated in the product listing."}],["$","p",null,{"children":"Do not assume compatibility with every vehicle, sensor, or data source. Follow the supplied installation instructions and confirm the required electrical connections before installation. Configure and interact with the gauge only when it is safe to do so."}],["$","p",null,{"children":"CE conformity and FCC authorization are launch goals. This preview does not claim that either process has been completed; market availability will be confirmed after the relevant requirements are addressed."}]]]}]
10:["$","section","campaign",{"id":"campaign","aria-labelledby":"campaign-title","children":[["$","div",null,{"className":"policy-section-heading","children":[["$","span",null,{"aria-hidden":"true","children":"03"}],["$","h2",null,{"id":"campaign-title","children":"Supporting the launch"}]]}],[["$","p",null,{"children":["The launch buttons are reserved for a future GoFundMe campaign. Once the link is available, contributions will be handled on GoFundMe under the campaign details and ",["$","a",null,{"href":"https://www.gofundme.com/c/terms","target":"_blank","rel":"noopener noreferrer","children":"GoFundMe’s terms"}],"."]}],["$","p",null,{"children":"Supporting the campaign is separate from buying a gauge through this store. Review what the campaign offers before contributing. These store terms do not promise a gauge or a tax deduction in return for a contribution."}]]]}]
11:["$","section","orders",{"id":"orders","aria-labelledby":"orders-title","children":[["$","div",null,{"className":"policy-section-heading","children":[["$","span",null,{"aria-hidden":"true","children":"04"}],["$","h2",null,{"id":"orders-title","children":"Orders and payment"}]]}],[["$","p",null,{"children":"Before submitting an order, check the product, quantity, currency, delivery address, shipping charges, taxes, and total shown at checkout. Use accurate contact details so we can send purchase and delivery information."}],["$","p",null,{"children":"Checkout is intended to be hosted by Stripe. Available payment methods will be shown there. Payment processing by Stripe does not make Stripe the seller of the gauge; Marcussen Motorsports handles the product, fulfillment, and customer support."}],["$","p",null,{"children":"An item will be clearly identified as a preorder before payment if it is not ready to ship. We will not substitute a product or charge a revised price without your agreement. If we cannot fulfill an order, we will contact you and refund any payment that must be returned."}]]]}]
12:["$","section","shipping",{"id":"shipping","aria-labelledby":"shipping-title","children":[["$","div",null,{"className":"policy-section-heading","children":[["$","span",null,{"aria-hidden":"true","children":"05"}],["$","h2",null,{"id":"shipping-title","children":"Shipping and delivery"}]]}],[["$","p",null,{"children":["We plan to ship to the United States and selected European Union countries, subject to launch availability."," Shipping rates and estimated dispatch timing will be shown before payment. Carrier transit estimates will be distinguished from the time needed to prepare an order."]}],["$","p",null,{"children":"If shipment cannot be made within the promised time, we will notify you, explain the revised timing, and provide the cancellation and refund options required by applicable law."}],["$","p",null,{"children":"Please contact us if a parcel is lost, damaged, or delivered incorrectly so we can investigate with the carrier. Any duties or import charges relevant to an offered destination will be explained before purchase."}]]]}]
13:["$","section","returns",{"id":"returns","aria-labelledby":"returns-title","children":[["$","div",null,{"className":"policy-section-heading","children":[["$","span",null,{"aria-hidden":"true","children":"06"}],["$","h2",null,{"id":"returns-title","children":"Cancellations, returns, and faults"}]]}],[["$","p",null,{"children":["See the ",["$","a",null,{"href":"/refund-policy","children":"refund policy"}]," for return eligibility, how to request a return, and how refunds are handled. Contact us promptly if you need to correct or cancel an order before dispatch."]}],["$","p",null,{"children":"A change-of-mind return policy is separate from your rights if a product is faulty, incorrect, or not as described. Nothing in these terms removes consumer rights or remedies that cannot legally be excluded."}],["$","p",null,{"children":["Any additional commercial warranty will be stated separately. Where EU consumer law applies, goods have a minimum two-year legal guarantee of conformity; national law may provide more protection. This is separate from the 30-day change-of-mind policy. See ",["$","a",null,{"href":"https://europa.eu/youreurope/citizens/consumers/shopping/guarantees/index_en.htm","target":"_blank","rel":"noopener noreferrer","children":"EU guidance on guarantees"}],"."]}]]]}]
